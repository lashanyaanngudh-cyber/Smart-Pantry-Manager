<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pantry_cream"
    android:orientation="vertical">

    <!-- Main content of the Pantry screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp">

        <!-- Pantry screen heading -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="My Pantry"
            android:textColor="@color/pantry_text"
            android:textSize="34sp"
            android:textStyle="bold" />


        <!-- First row of information blocks -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <!-- Number of items in the pantry -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/card_sage"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Displays the total number of pantry items -->
                <TextView
                    android:id="@+id/total_items_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/pantry_text"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Items in Pantry"
                    android:textColor="@color/pantry_secondary_text"
                    android:textSize="15sp" />

            </LinearLayout>


            <!-- Number of items that are low in stock -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/card_peach"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Displays the number of low stock items -->
                <TextView
                    android:id="@+id/low_stock_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/pantry_text"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Low Stock"
                    android:textColor="@color/pantry_secondary_text"
                    android:textSize="15sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- Second row of information blocks -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- Number of items that are expiring soon -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/card_beige"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Displays the number of expiring items -->
                <TextView
                    android:id="@+id/expiring_items_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/pantry_text"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Expiring Soon"
                    android:textColor="@color/pantry_secondary_text"
                    android:textSize="15sp" />

            </LinearLayout>


            <!-- Button used to open the Add Ingredient screen -->
            <Button
                android:id="@+id/open_add_ing_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/pantry_light_sage"
                android:text="+  Add Item"
                android:textAllCaps="false"
                android:textColor="@color/pantry_text"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="18dp" />

        </LinearLayout>


        <!-- Heading above the pantry item list -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="Pantry Items"
            android:textColor="@color/pantry_text"
            android:textSize="23sp"
            android:textStyle="bold" />


        <!-- Displays all pantry items -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pantry_recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>


    <!-- Bottom navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pantry_sage"
        app:itemIconTint="@color/pantry_text"
        app:itemTextColor="@color/pantry_text"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation_menu" />

</LinearLayout>
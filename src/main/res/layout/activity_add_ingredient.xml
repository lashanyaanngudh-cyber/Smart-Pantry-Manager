<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Screen title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Ingredient"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- Ingredient name -->
    <EditText
        android:id="@+id/ing_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingredient Name"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <!-- Ingredient quantity -->
    <EditText
        android:id="@+id/ing_quantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Quantity"
        android:inputType="numberDecimal"
        android:layout_marginBottom="12dp" />

    <!-- Ingredient unit -->
    <EditText
        android:id="@+id/ing_unit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Unit"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <!-- Ingredient expiry date -->
    <EditText
        android:id="@+id/ing_expirydate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Expiry Date (YYYY-MM-DD)"
        android:inputType="date"
        android:layout_marginBottom="20dp" />

    <!-- Button used to add the ingredient -->
    <Button
        android:id="@+id/add_ing_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Ingredient" />

</LinearLayout>
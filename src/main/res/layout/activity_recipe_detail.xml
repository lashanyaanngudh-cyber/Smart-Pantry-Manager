<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pantry_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="30dp">

        <!-- Top section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="70dp"
            android:paddingBottom="10dp">

            <!-- Back arrow -->
            <TextView
                android:id="@+id/recipe_back_arrow"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="Back to Recipes"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/pantry_text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <!-- Recipe name -->
            <TextView
                android:id="@+id/txtRecipeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="55dp"
                android:layout_marginEnd="20dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Recipe Name"
                android:textColor="@color/pantry_text"
                android:textSize="26sp"
                android:textStyle="bold" />

        </RelativeLayout>


        <!-- Ingredients heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:text="Ingredients"
            android:textColor="@color/pantry_text"
            android:textSize="22sp"
            android:textStyle="bold" />


        <!-- Ingredients card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/pantry_item_card"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Ingredient list -->
            <TextView
                android:id="@+id/txtIngredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="5dp"
                android:text="Ingredients will appear here"
                android:textColor="@color/pantry_text"
                android:textSize="16sp" />

        </LinearLayout>


        <!-- Method heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp"
            android:text="Method"
            android:textColor="@color/pantry_text"
            android:textSize="22sp"
            android:textStyle="bold" />


        <!-- Method card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/pantry_item_card"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Recipe instructions -->
            <TextView
                android:id="@+id/txtInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:text="Instructions will appear here"
                android:textColor="@color/pantry_text"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
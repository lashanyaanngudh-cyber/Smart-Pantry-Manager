<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/pantry_item_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top row contains the item name and three-dot button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Pantry item name -->
        <TextView
            android:id="@+id/pitem_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="Item Name"
            android:textColor="@color/pantry_text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Opens the item details screen -->
        <TextView
            android:id="@+id/item_options_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Item options"
            android:gravity="center"
            android:text="⋮"
            android:textColor="@color/pantry_text"
            android:textSize="28sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- Displays quantity and unit together -->
    <TextView
        android:id="@+id/pitem_quantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Quantity: 0 pieces"
        android:textColor="@color/pantry_secondary_text"
        android:textSize="15sp" />


    <!-- We keep this because the current adapter uses this ID -->
    <TextView
        android:id="@+id/pitem_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />


    <!-- Bottom row contains expiry date and status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Pantry item expiry date -->
        <TextView
            android:id="@+id/pitem_expirydate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Expiry: 01 Jan 2027"
            android:textColor="@color/pantry_secondary_text"
            android:textSize="15sp" />

        <!-- Expiry status -->
        <TextView
            android:id="@+id/pitem_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/card_sage"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="GOOD"
            android:textColor="@color/pantry_text"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
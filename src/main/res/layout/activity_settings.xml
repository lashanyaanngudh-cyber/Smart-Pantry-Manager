<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pantry_cream"
    android:orientation="vertical">

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp">

        <!-- Screen heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Settings"
            android:textColor="@color/pantry_text"
            android:textSize="34sp"
            android:textStyle="bold" />


        <!-- Notifications heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="10dp"
            android:text="Notifications"
            android:textColor="@color/pantry_text"
            android:textSize="22sp"
            android:textStyle="bold" />


        <!-- Notifications card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/pantry_item_card"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Expiry alerts -->
            <Switch
                android:id="@+id/switchExpiryAlerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Expiry reminders"
                android:textColor="@color/pantry_text"
                android:textSize="17sp" />


            <!-- Low stock alerts -->
            <Switch
                android:id="@+id/switchLowStockAlerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Low stock reminders"
                android:textColor="@color/pantry_text"
                android:textSize="17sp" />

        </LinearLayout>


        <!-- Preferences heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="10dp"
            android:text="Preferences"
            android:textColor="@color/pantry_text"
            android:textSize="22sp"
            android:textStyle="bold" />


        <!-- Preferences card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/pantry_item_card"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Unit heading -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preferred Unit"
                android:textColor="@color/pantry_secondary_text"
                android:textSize="15sp" />


            <!-- Unit choices -->
            <Spinner
                android:id="@+id/spinnerUnit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="5dp" />

        </LinearLayout>


        <!-- Save settings -->
        <Button
            android:id="@+id/buttonSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/pantry_light_sage"
            android:text="Save Settings"
            android:textAllCaps="false"
            android:textColor="@color/pantry_text"
            android:textSize="17sp"
            android:textStyle="bold"
            app:cornerRadius="18dp" />

    </LinearLayout>


    <!-- Bottom navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pantry_sage"
        app:itemIconTint="@color/pantry_text"
        app:itemTextColor="@color/pantry_text"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation_menu" />

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pantry_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="30dp">


        <!-- Top section -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="60dp">

            <!-- Returns to the Pantry screen -->
            <TextView
                android:id="@+id/item_detail_back_arrow"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="start|center_vertical"
                android:contentDescription="Back to Pantry"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/pantry_text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <!-- Screen heading -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:text="Item Details"
                android:textColor="@color/pantry_text"
                android:textSize="30sp"
                android:textStyle="bold" />

        </FrameLayout>


        <!-- Item name label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Item Name"
            android:textColor="@color/pantry_secondary_text"
            android:textSize="14sp" />


        <!-- Editable item name -->
        <EditText
            android:id="@+id/item_detail_name"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/pantry_item_card"
            android:hint="Item name"
            android:inputType="textCapWords"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/pantry_text"
            android:textColorHint="@color/pantry_secondary_text"
            android:textSize="17sp"
            android:textStyle="bold" />


        <!-- Quantity label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Quantity"
            android:textColor="@color/pantry_secondary_text"
            android:textSize="14sp" />


        <!-- Editable quantity -->
        <EditText
            android:id="@+id/item_detail_quantity"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/pantry_item_card"
            android:hint="Quantity"
            android:inputType="numberDecimal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/pantry_text"
            android:textColorHint="@color/pantry_secondary_text"
            android:textSize="17sp"
            android:textStyle="bold" />


        <!-- Unit label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Unit"
            android:textColor="@color/pantry_secondary_text"
            android:textSize="14sp" />


        <!-- Editable unit -->
        <EditText
            android:id="@+id/item_detail_unit"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/pantry_item_card"
            android:hint="e.g. L, ml, g, kg or piece"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/pantry_text"
            android:textColorHint="@color/pantry_secondary_text"
            android:textSize="17sp"
            android:textStyle="bold" />


        <!-- Expiry date label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Expiry Date"
            android:textColor="@color/pantry_secondary_text"
            android:textSize="14sp" />


        <!-- Editable expiry date -->
        <EditText
            android:id="@+id/item_detail_expiry"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/pantry_item_card"
            android:hint="YYYY-MM-DD"
            android:inputType="date"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/pantry_text"
            android:textColorHint="@color/pantry_secondary_text"
            android:textSize="17sp"
            android:textStyle="bold" />


        <!-- Space before buttons -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="35dp" />


        <!-- Edit and Delete buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal">


            <!-- Saves changes to the item -->
            <Button
                android:id="@+id/item_detail_edit_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/pantry_light_sage"
                android:text="Edit"
                android:textAllCaps="false"
                android:textColor="@color/pantry_text"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="18dp" />


            <!-- Deletes the item -->
            <Button
                android:id="@+id/item_detail_delete_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Delete"
                android:textAllCaps="false"
                android:textColor="@color/pantry_text"
                android:textSize="17sp"
                android:textStyle="bold"
                app:backgroundTint="@color/pantry_peach"
                app:cornerRadius="18dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>